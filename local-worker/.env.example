# Copy to local-worker\.env — never commit the real file.
INGEST_URL=https://cinema-radar-egypt.vercel.app/api/ingest
# Same value as LOCAL_WORKER_TOKEN in Vercel → Settings → Environment Variables
LOCAL_WORKER_TOKEN=
SCRAPER_CONTACT=https://cinema-radar-egypt.vercel.app
# Providers this laptop may read (remove one to switch it off)
# VOX is off: its Akamai front end does not answer self-identified monitors (see README)
PROVIDERS=scene
