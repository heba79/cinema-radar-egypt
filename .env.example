# ─── Cinema Radar Egypt — environment template ────────────────────────────────
# Copy to .env.local (web, local dev) and set the same values as secrets on
# Vercel (web) and Fly.io (worker). NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to browsers by design (public keys only).

# --- Supabase (Project Settings → API / Database) -----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # anon/public key (safe for browsers; RLS protects data)
# Postgres connection used server-side by the website and the worker.
# Web on Vercel: use the *transaction pooler* (port 6543). Worker: session pooler (5432) or direct.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- TMDB (https://www.themoviedb.org/settings/api) — metadata only ----------
TMDB_READ_TOKEN=eyJ...                          # "API Read Access Token" (preferred)
# TMDB_API_KEY=...                              # or the v3 API key

# --- Email (https://resend.com) ----------------------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM=Cinema Radar Egypt <alerts@your-verified-domain.com>

# --- Web Push (generate with: npm run vapid:generate) ------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Telegram (optional; create a bot with @BotFather) -----------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=                          # without @
TELEGRAM_WEBHOOK_SECRET=                        # any random string (openssl rand -hex 24)

# --- App ---------------------------------------------------------------------
APP_URL=https://your-app.vercel.app             # used in alert links
ADMIN_EMAILS=you@example.com                    # comma-separated; these users see /admin
SCRAPER_CONTACT=https://your-app.vercel.app     # shown in the crawler User-Agent
MONITOR_INTERVAL_SECONDS=300                    # watched-movie check interval (min 60)
# PG_POOL_MAX=5
# ELCINEMA_MIN_GAP_MS=3000
# VOX_MIN_GAP_MS=10000
